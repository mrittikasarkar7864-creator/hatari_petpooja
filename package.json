{
  "name": "Hatari",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios --simulator \"iPhone 16\"",
    "ios:device": "react-native run-ios --udid 00008120-0004458A21B9A01E --extra-params \"-allowProvisioningUpdates -allowProvisioningDeviceRegistration\"",
    "ios:udid": "react-native run-ios --udid 00008140-000838E20C83801C",
    "ios:list": "react-native run-ios --list-devices",
    "playstorebuild": "cd android && gradlew bundleRelease",
    "lint": "eslint .",
    "start": "react-native start",
    "start:reset": "react-native start --reset-cache",
    "postinstall": "patch-package",
    "test": "jest"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/blur": "^4.4.1",
    "@react-native-community/datetimepicker": "^8.5.1",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-navigation/bottom-tabs": "^7.9.0",
    "@react-navigation/elements": "^2.9.3",
    "@react-navigation/native": "^7.1.26",
    "@react-navigation/native-stack": "^7.9.0",
    "@react-navigation/stack": "^7.8.10",
    "@reduxjs/toolkit": "^2.11.2",
    "axios": "^1.13.2",
    "geolib": "^3.3.14",
    "moment": "^2.30.1",
    "react": "19.0.0",
    "react-native": "0.79.0",
    "react-native-android-location-enabler": "^3.0.1",
    "react-native-confirmation-code-field": "^8.0.1",
    "react-native-geolocation-service": "^5.3.1",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-google-places-autocomplete": "^2.6.4",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-maps": "^1.20.1",
    "react-native-permissions": "^5.4.4",
    "react-native-responsive-dimensions": "^3.1.1",
    "react-native-responsive-screen": "^1.4.2",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "^4.12.0",
    "react-native-shimmer-placeholder": "^2.0.9",
    "react-native-size-matters": "^0.4.2",
    "react-native-svg": "^15.15.1",
    "react-native-vector-icons": "^10.3.0",
    "react-native-version-check": "^3.5.0",
    "react-redux": "^9.2.0",
    "redux-persist": "^6.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "^18.0.1",
    "@react-native-community/cli-platform-android": "18.0.0",
    "@react-native-community/cli-platform-ios": "18.0.0",
    "@react-native/babel-preset": "0.79.0",
    "@react-native/eslint-config": "0.79.0",
    "@react-native/metro-config": "0.79.0",
    "@react-native/typescript-config": "0.79.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.0.0",
    "@types/react-test-renderer": "^19.0.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "patch-package": "^8.0.1",
    "prettier": "2.8.8",
    "react-test-renderer": "19.0.0",
