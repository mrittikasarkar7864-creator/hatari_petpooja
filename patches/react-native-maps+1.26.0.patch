+  getAddressFromCoordinates(tag: Double, coordinate: LatLng) {
+    return getModule().getAddressFromCoordinates(tag, coordinate);
+  },
+  getPointForCoordinate(tag: Double, coordinate: LatLng) {
+    return getModule().getPointForCoordinate(tag, coordinate);
+  },
+  getCoordinateForPoint(tag: Double, point: Point) {
+    return getModule().getCoordinateForPoint(tag, point);
+  },
+};
