+const getModule = (): Spec => {
+  const module = TurboModuleRegistry.get<Spec>('RNMapsAirModule');
+
+  if (!module) {
+    throw new Error(
+      'RNMapsAirModule is only available when react-native-maps is running with the iOS Fabric implementation.',
+    );
+  }
+
+  return module;
+};
+
+const NativeAirMapsModule: Spec = {
+  getCamera(tag: Double) {
+    return getModule().getCamera(tag);
+  },
+  getMarkersFrames(tag: Double, onlyVisible: boolean) {
+    return getModule().getMarkersFrames(tag, onlyVisible);
+  },
+  getMapBoundaries(tag: Double) {
+    return getModule().getMapBoundaries(tag);
+  },
+  takeSnapshot(tag: Double, config: string) {
